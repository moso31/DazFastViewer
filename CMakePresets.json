{
  "version": 6,
  "cmakeMinimumRequired": {"major": 4, "minor": 2, "patch": 0},
  "configurePresets": [
    {
      "name": "windows-base", "hidden": true,
      "architecture": "x64", "toolset": "v143",
      "cacheVariables": {"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/${presetName}/Release"}
    },
    {"name": "vs2022", "displayName": "VS 2022 x64 (v143)", "inherits": "windows-base", "generator": "Visual Studio 17 2022", "binaryDir": "${sourceDir}/build/vs2022"},
    {"name": "vs2026", "displayName": "VS 2026 x64 (v143 for CUDA 12.9)", "inherits": "windows-base", "generator": "Visual Studio 18 2026", "binaryDir": "${sourceDir}/build/vs2026"}
  ],
  "buildPresets": [
    {"name": "vs2022-release", "configurePreset": "vs2022", "configuration": "Release", "jobs": 4},
    {"name": "vs2022-debug", "configurePreset": "vs2022", "configuration": "Debug", "jobs": 4},
    {"name": "vs2026-release", "configurePreset": "vs2026", "configuration": "Release", "jobs": 4},
    {"name": "vs2026-debug", "configurePreset": "vs2026", "configuration": "Debug", "jobs": 4}
  ],
  "testPresets": [
    {"name": "vs2022-release", "configurePreset": "vs2022", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "vs2022-debug", "configurePreset": "vs2022", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "vs2026-release", "configurePreset": "vs2026", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "vs2026-debug", "configurePreset": "vs2026", "configuration": "Debug", "output": {"outputOnFailure": true}}
  ]
}
