static void hd_inner_recovery(const fs::path &file){
  J recovery;std::ifstream(file)>>recovery;std::vector<fs::path> roots;for(const auto &root:recovery.at("roots"))roots.push_back(fs::u8path(root.get<std::string>()));
  std::cout<<"Loading last recovery"<<std::endl;auto loaded=restore_scene_extension(recovery.at("scene"),file.parent_path(),roots,1);auto &d=*loaded.document;auto &s=loaded.snapshot;
  size_t host=SIZE_MAX,target=SIZE_MAX;for(size_t t=0;t<d.catalog.targets.size();++t)if(d.catalog.targets[t].id==recovery.at("active").at("object").get<std::string>())host=t;
  check(host!=SIZE_MAX,"恢复点没有选中角色");for(auto t:geograft_targets(d,host))if(geograft_material_strategy(d,t)==GeograftMaterialStrategy::hd_nipples)target=t;
  check(target!=SIZE_MAX,"恢复点角色没有 HD Nipples");const auto instance=d.catalog.targets[target].instance;
  const auto slots=d.loaded.scene.meshes.at(d.loaded.scene.instances.at(instance).mesh).material_slots;
  auto materials=[&](const Document &document,const Snapshot &state){J result=J::array();for(size_t n=0;n<slots.size();++n){const auto material=copy_material(document.loaded.scene,state.material_overrides,{instance,n});ir::Material source;source.source_definition=material.at("source_definition");result.push_back({{"surface",slots[n]},{"opacity",material.at("parameters").at("opacity")},{"uv",daz::material_uv_set(source).label}});}return result;};
  const auto before=signature(d,s);auto original=d;const auto state=s;J report={{"before",materials(d,s)},{"updated",recovery.at("updated")},{"host",d.catalog.targets[host].label}};
  fs::path directory;for(size_t slot=0;slot<slots.size();++slot)if(slots[slot]=="HD Nipples L")directory=fs::u8path(copy_material(d.loaded.scene,s.material_overrides,{instance,slot}).at("parameters").at("color_texture").at("file").get<std::string>()).parent_path();
  const auto matches=find_hd_textures(d,s,target,roots,directory.parent_path());check(std::find(matches.begin(),matches.end(),directory)!=matches.end(),"恢复点的 HD 缓存与当前角色不匹配");
  const auto result=update_geograft_materials(d,s,target,roots,directory);check(result.updated==5&&result.fallback==0&&result.unresolved.empty(),"真实 HD 更新没有全部成功");
  auto verify=[&](const Document &document,const Snapshot &snapshot,bool hd){for(size_t slot=0;slot<slots.size();++slot){const auto material=copy_material(document.loaded.scene,snapshot.material_overrides,{instance,slot});ir::Material source;source.source_definition=material.at("source_definition");const auto uv=daz::material_uv_set(source);const bool local=slots[slot]=="HD Nipples L"||slots[slot]=="HD Nipples R";check(hd&&local?uv.label=="HD UVs":uv.uri.ends_with("#default"),"真实表面的 UV 分工错误");check(material.at("parameters").at("opacity")== (slots[slot]=="Inner"?0:1),"真实 Inner 未隐藏或外部皮肤被隐藏");if(slots[slot]=="Inner")check(material.at("parameters").at("opacity_texture").is_null(),"隐藏 Inner 仍有皮肤透明贴图");}};
  verify(d,s,true);report["after"]=materials(d,s);check(signature(original,state)==before,"更新破坏撤销文档");
  auto fallback=original;auto fallback_state=state;const auto copied=update_geograft_materials(fallback,fallback_state,target,roots,{},"验证皮肤回退");check(copied.updated==5&&copied.fallback==5&&copied.unresolved.empty(),"真实通用回退没有完成");verify(fallback,fallback_state,false);report["fallback"]=materials(fallback,fallback_state);
  const auto after=signature(d,s);for(auto it=before.begin();it!=before.end();++it)if(it.key()!=d.loaded.scene.instances[instance].id)check(after.at(it.key())==it.value(),"修复影响了其他对象材质");
  const auto folder=fs::absolute("artifacts/hd-inner-diagnosis"),saved=folder/"repaired.dufex";save_scene_extension(saved,d,s);std::cout<<"Saved repaired recovery; reloading"<<std::endl;auto restored=load_scene_extension(saved,roots,2);check(signature(*restored.document,restored.snapshot)==after,"修复结果保存重载不一致");
  const auto &a=d.loaded.scene.meshes.at(d.loaded.scene.instances[instance].mesh);const auto &b=restored.document->loaded.scene.meshes.at(restored.document->loaded.scene.instances[instance].mesh);check(a.triangles==b.triangles,"实际 UV 坐标保存重载不一致");
  report["status"]="PASS";std::ofstream(folder/"inner-repair.json")<<report.dump(2);std::cout<<"PASS recovery / Inner opacity / peripheral UV / fallback / save-reload"<<std::endl;
}
